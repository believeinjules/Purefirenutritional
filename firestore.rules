rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Pure Fire Nutritional — PRODUCTION Firestore rules (complete file).
//
// Replaces the expired test-mode rule (`allow read, write: if request.time <
// timestamp.date(2026, 7, 1)`). Deploy the WHOLE file (Firebase console →
// Firestore → Rules → paste → Publish, or `firebase deploy --only
// firestore:rules`).
//
// Server code (api/*, Stripe webhook, prerender) uses the Admin SDK and
// bypasses these rules. Only browser (client SDK) access is governed here.
//
// Client-side access found in the repo (customer-reviews branch):
//   products          read          storefront, search, cart, PDP (public)
//   profiles/{uid}    create        AuthContext.signUp (signed-in, own uid)
//   orders            list/read     Dashboard (where customer_email == user.email)
//   reviews           create        /review form (pending only)
//   abandoned_carts   read/update   Admin.tsx (admin only; client never creates)
//   customer_wishlist (lib present, currently unused — owner-only by email)
//   product_reviews   (legacy, unused — denied)
// Everything else (customers, mailing_list, inventory, …) is Admin-SDK only.
//
// ADMINS: keep in sync with server ADMIN_EMAILS (Vercel env). Value below is
// from .env.local.example — confirm it matches production.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return verifiedEmail()
        && request.auth.token.email.lower() in ['julesxshulman@gmail.com', 'purefiren@gmail.com'];
    }

    // ── Catalog: public read, writes via /api/admin/products only ──────────
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Customer profile: owner only ───────────────────────────────────────
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'fullName', 'email', 'birthday', 'createdAt', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(
             ['uid', 'fullName', 'email', 'birthday', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // ── Orders: written by the Stripe webhook (Admin SDK). Customers read
    //    their own (verified email must match), admins read all. ───────────
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (verifiedEmail()
            && resource.data.customer_email == request.auth.token.email.lower());
      allow write: if false;
    }

    // ── Wishlist (not currently used by the UI; kept owner-only) ──────────
    match /customer_wishlist/{itemId} {
      allow read, delete: if verifiedEmail()
        && resource.data.customerEmail == request.auth.token.email;
      allow create: if verifiedEmail()
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['customerEmail', 'productId', 'notifyOnSale', 'notifyOnRestock', 'addedAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 100;
      allow update: if verifiedEmail()
        && resource.data.customerEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['notifyOnSale', 'notifyOnRestock']);
    }

    // ── Abandoned carts: Admin dashboard reads + marks recovery sent ───────
    match /abandoned_carts/{cartId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['recoveryEmailSent', 'recoveryEmailSentAt', 'recovered', 'recoveredAt']);
      allow create, delete: if false;
    }

    // Reviews: no browser access at all. The public /review form POSTs to
    // /api/reviews (zod validation, honeypot, per-IP rate limit), which writes
    // pending docs with the Admin SDK; admin moderation uses /api/admin/reviews.
    // review_rate_limits is server-only too (default deny below).
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // ── Default deny: customers, mailing_list, product_inventory,
    //    inventory_history, product_reviews (legacy), anything new. ────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
