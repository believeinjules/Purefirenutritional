rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Pure Fire Nutritional — Firestore rules: `reviews` collection.
//
// IMPORTANT: this repo did not previously contain the project's Firestore
// rules (they live in the Firebase console). Do NOT deploy this file on its
// own — deploying replaces ALL rules and would lock out wishlist, carts,
// orders, profiles, products, etc. Paste the `match /reviews/{reviewId}` block
// below INTO the existing rules in Firebase console → Firestore → Rules,
// inside the existing `match /databases/{database}/documents { … }`.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Customer reviews (public /review form).
    // Browsers may only CREATE a pending review with validated fields.
    // Reads/updates/deletes happen server-side via the Admin SDK
    // (/api/reviews, /api/admin/reviews), which bypasses these rules.
    match /reviews/{reviewId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'productId', 'rating', 'text', 'firstName', 'lastInitial', 'email',
          'date', 'usedProduct', 'permission', 'verified', 'approved',
          'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'productId', 'rating', 'text', 'firstName', 'lastInitial', 'email',
          'date', 'usedProduct', 'permission', 'verified', 'approved',
          'status', 'source', 'createdAt'
        ]) &&
        // Moderation state can only start as pending / not public.
        request.resource.data.status == 'pending' &&
        request.resource.data.approved == false &&
        request.resource.data.verified == false &&
        request.resource.data.permission == true &&
        request.resource.data.usedProduct == true &&
        request.resource.data.source == 'customer-form' &&
        request.resource.data.createdAt == request.time &&
        // Field shapes / sizes.
        request.resource.data.productId is string &&
        request.resource.data.productId.matches('^[a-z0-9][a-z0-9-]{0,99}$') &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 10 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() >= 1 &&
        request.resource.data.firstName.size() <= 40 &&
        request.resource.data.lastInitial is string &&
        request.resource.data.lastInitial.size() <= 1 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 200 &&
        (request.resource.data.email == '' ||
          request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')) &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
