rules_version = '2';

// Firebase Storage — product images uploaded from Admin → Products
// (client SDK: products/<timestamp>-<rand>.<ext>). Public read so the
// storefront can show them; only admins (keep in sync with ADMIN_EMAILS)
// may upload images up to 5 MB. Everything else denied.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['julesxshulman@gmail.com', 'purefiren@gmail.com'];
    }

    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
