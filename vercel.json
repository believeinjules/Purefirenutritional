{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "pnpm install",
  "framework": null,
  "outputDirectory": "dist",
  "functions": {
    "api/peppy.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/products/:id(femalin|temero-genero|trezvon|olecap|previn|regenart|gelmigon)",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/products/:id(bonomarlot|cartalax|chelohart|crystagen|endoluten|gotratix|pielotax|testoluten|thyreogen|ventfort|vesugen|visoluten|vladonix)-:size(n20|n60)",
      "destination": "/products/:id",
      "statusCode": 301
    },
    {
      "source": "/product/:id",
      "destination": "/products/:id",
      "statusCode": 301
    },
    {
      "source": "/documentation",
      "destination": "/authenticity",
      "statusCode": 301
    },
    {
      "source": "/documentation/:slug",
      "destination": "/authenticity/:slug",
      "statusCode": 301
    },
    {
      "source": "/research",
      "destination": "/science",
      "statusCode": 301
    },
    {
      "source": "/learn/cytomaxes-vs-cytogens",
      "destination": "/learn/what-are-khavinson-peptide-bioregulators#cytomaxes-vs-cytogens",
      "statusCode": 301
    },
    {
      "source": "/learn",
      "destination": "/insights",
      "statusCode": 301
    }
  ]
}
