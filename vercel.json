{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "pnpm install",
  "framework": null,
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/peppy.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "purefirenutritional.com"
        }
      ],
      "destination": "https://www.purefirenutritional.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product_shipping_class"
        }
      ],
      "destination": "/products",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "taxonomy"
        }
      ],
      "destination": "/products",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/products/:id(femalin|temero-genero|trezvon|olecap|panaxod|previn|regenart|gelmigon|calsil-t|indosine)",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/products/:id(bonomarlot|bonothyrk|cartalax|cerluten|chelohart|chitomur|chonluten|crystagen|endoluten|glandokort|gotratix|libidon|ovagen|pielotax|pinealon|sigumir|stamakort|suprefort|svetinorm|taxorest|testoluten|thyreogen|ventfort|vesugen|visoluten|vladonix|zhenoluten)-:size(n20|n60)",
      "destination": "/products/:id",
      "statusCode": 301
    },
    {
      "source": "/product/:id",
      "destination": "/products/:id",
      "statusCode": 301
    },
    {
      "source": "/documentation",
      "destination": "/authenticity",
      "statusCode": 301
    },
    {
      "source": "/documentation/:slug",
      "destination": "/authenticity/:slug",
      "statusCode": 301
    },
    {
      "source": "/research",
      "destination": "/science",
      "statusCode": 301
    },
    {
      "source": "/learn/cytomaxes-vs-cytogens",
      "destination": "/learn/what-are-khavinson-peptide-bioregulators#cytomaxes-vs-cytogens",
      "statusCode": 301
    },
    {
      "source": "/journal",
      "destination": "/learn",
      "statusCode": 301
    },
    {
      "source": "/journal/:slug",
      "destination": "/learn/:slug",
      "statusCode": 301
    },
    {
      "source": "/pepita",
      "destination": "/ai-assistant",
      "statusCode": 301
    },
    {
      "source": "/products/system/heart-blood-vessels",
      "destination": "/products/system/heart-circulation",
      "permanent": true
    },
    {
      "source": "/products/system/immune-thymus",
      "destination": "/products/system/immune-respiratory",
      "permanent": true
    },
    {
      "source": "/products/system/lungs-airways",
      "destination": "/products/system/immune-respiratory",
      "permanent": true
    },
    {
      "source": "/products/system/liver-digestive",
      "destination": "/products/system/digestion-metabolism",
      "permanent": true
    },
    {
      "source": "/products/system/joints-bones-cartilage",
      "destination": "/products/system/bones-joints-muscles",
      "permanent": true
    },
    {
      "source": "/products/system/muscle",
      "destination": "/products/system/bones-joints-muscles",
      "permanent": true
    },
    {
      "source": "/products/system/endocrine-glands",
      "destination": "/products/system/hormonal-reproductive-health",
      "permanent": true
    },
    {
      "source": "/products/system/womens-health",
      "destination": "/products/system/hormonal-reproductive-health",
      "permanent": true
    },
    {
      "source": "/products/system/mens-health",
      "destination": "/products/system/hormonal-reproductive-health",
      "permanent": true
    },
    {
      "source": "/products/goal/stress-mood",
      "destination": "/products/goal/stress-resilience",
      "permanent": true
    },
    {
      "source": "/products/collection/hair-skin-beauty",
      "destination": "/products/goal/skin-hair-beauty",
      "permanent": true
    },
    {
      "source": "/products/goal/eyes-vision",
      "destination": "/khavinson-peptides-list",
      "permanent": true
    },
    {
      "source": "/products/goal/antioxidant-support",
      "destination": "/products",
      "permanent": true
    }
  ]
}
